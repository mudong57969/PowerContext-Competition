# ExamPilot backend configuration (copy to .env and adjust)

# --- seekdb (embedded database, requires Linux/macOS, e.g. WSL2) ---
# Directory where the embedded seekdb instance stores its data.
# Must be on a native Linux filesystem (Unix sockets do not work on drvfs mounts).
EXAMPILOT_SEEKDB_PATH=/home/<user>/exampilot-data/seekdb

# --- PowerContext long-term memory ---
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
# Scope prefix used for demo-session isolation
EXAMPILOT_MEMORY_SCOPE_PREFIX=exampilot

# --- Embedding (semantic search) ---
# Options:
#   "local"  -> local fastembed model (downloaded once, no API key needed)
#   "openai" -> OpenAI-compatible embedding API
#   "none"   -> disable semantic search (fulltext-only, clearly flagged)
EXAMPILOT_EMBEDDING_PROVIDER=local
EXAMPILOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EXAMPILOT_EMBEDDING_DIMENSION=512
# For provider=openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=
EXAMPILOT_EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# --- Automatic classification thresholds (0..1) ---
# confidence >= high  -> auto-filed
# high > conf >= mid  -> suggested (one-click confirm)
# conf < mid          -> pending review
EXAMPILOT_CLASSIFY_HIGH_CONFIDENCE=0.65
EXAMPILOT_CLASSIFY_MID_CONFIDENCE=0.45

# --- LLM (question generation / explanations) ---
# Optional. When unset, ExamPilot uses retrieval-grounded templates and the
# built-in fixed question bank; the UI shows that AI generation is unavailable.
EXAMPILOT_LLM_PROVIDER=none
EXAMPILOT_LLM_BASE_URL=
EXAMPILOT_LLM_API_KEY=
EXAMPILOT_LLM_MODEL=

# --- Service ---
EXAMPILOT_HOST=127.0.0.1
EXAMPILOT_PORT=8001
EXAMPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum uploads per request and per-file size (bytes)
EXAMPILOT_MAX_UPLOAD_FILES=50
EXAMPILOT_MAX_FILE_BYTES=52428800
